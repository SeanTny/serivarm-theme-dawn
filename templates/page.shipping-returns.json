          "type": "collapsible_row",
          "settings": {
            "heading": "How long does shipping take?",
            "icon": "check_mark",
            "row_content": "<p></p><p>Orders are processed within <strong>{{ metaobjects.shipping_and_returns[\"shipping-and-returns-brpnpwnf\"].shipping_processing.value }}</strong>. After shipment, delivery typically takes <strong>{{ metaobjects.shipping_and_returns[\"shipping-and-returns-brpnpwnf\"].shipping_transit.value }}</strong> within the United States. In total, most orders arrive within <strong>{{ metaobjects.shipping_and_returns[\"shipping-and-returns-brpnpwnf\"].shipping_total.value }}</strong>.</p>",
            "page": ""
          }
        },
        "collapsible_row_CFbnfU": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I start a return?",
            "icon": "check_mark",
            "row_content": "<p><br/>Simply contact our support team with your order number. We'll guide you through the return process. Email:<a href=\"mailto:support@serivarm.com\">support@serivarm.com</a>.</p><p></p>",
            "page": ""
          }
        },
        "collapsible_row_N9wLNc": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is your return policy?",
            "icon": "check_mark",
            "row_content": "<p><br/>You may request a return within <strong>{{ metaobjects.shipping_and_returns[\"shipping-and-returns-brpnpwnf\"].return.value }}</strong> of receiving your order, provided the item meets our return requirements. <a href=\"/policies/refund-policy\" target=\"_blank\" title=\"Refund Policy\">refund-policy</a></p><p></p>",
            "page": ""
          }
        },
        "collapsible_row_VXpL3n": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do you ship across the United States?",
            "icon": "check_mark",
            "row_content": "<p><br/>Yes. We currently ship throughout the United States.</p><p></p>",
            "page": ""
