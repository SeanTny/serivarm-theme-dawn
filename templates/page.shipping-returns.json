        },
        "collapsible_row_iFgnnV": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Who pays for return shipping?",
            "icon": "check_mark",
            "row_content": "<p><br/>If the return is due to a product defect or an order error, we'll make it right. For other returns, return shipping may be the customer's responsibility.</p><p></p>",
